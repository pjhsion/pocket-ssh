{
  "name": "pocket-ssh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first SSH terminal PWA with configurable spaces, agents and tabs",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pocket-ssh": "./bin/pocket-ssh.mjs"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src test scripts",
    "lint:fix": "biome check --write src test scripts"
  },
  "dependencies": {
    "ssh2": "1.17.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.0",
    "@types/ssh2": "1.15.5",
    "@types/ws": "8.18.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "playwright": "1.62.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "ssh2@1.17.0": true,
    "esbuild@0.28.2": true
  }
}
